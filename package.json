{
  "name": "team-task-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.5.1",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx watch server/dev.ts\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server/dev.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "auth:migrate": "npx auth@1.7.12 migrate --config server/auth.ts --yes"
  },
  "dependencies": {
    "better-auth": "^1.7.12",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
